---
import BaseLayout from '../layouts/BaseLayout.astro'
import NoteCard from '../components/NoteCard.astro'
import BlogCard from '../components/BlogCard.astro'
import { getCollection } from 'astro:content'

/**
 * 性能优化思路：
 * 1. 所有数据处理在 Astro SSG 构建时完成，客户端零 JS 开销
 * 2. 首页只取 5+5=10 条数据，数量小保证了子列表构建 O(n)
 * 3. 笔记按日期排序，博客按 modDatetime/pubDatetime 排序
 * 4. 卡片使用原生 <a> 标签，无 React 水合
 * 5. 封面图片使用了 loading="lazy" + decoding="async" 延迟加载
 * 6. hover 效果仅使用 CSS transform/opacity，触发 GPU 合成
 * 7. 首页无分页，减少构建路径数量
 */

const allNotes = await getCollection('notes')
const allPosts = await getCollection('posts')

// 笔记：按日期从新到旧排序（无日期排末尾），取前 5
const sortedNotes = [...allNotes]
    .sort((a, b) => {
        const aDate = a.data.date
        const bDate = b.data.date
        if (!aDate && !bDate) return a.data.title.localeCompare(b.data.title, 'zh-CN')
        if (!aDate) return 1
        if (!bDate) return -1
        const diff = bDate.valueOf() - aDate.valueOf()
        if (diff !== 0) return diff
        return a.data.title.localeCompare(b.data.title, 'zh-CN')
    })
    .slice(0, 5)

// 博客：过滤草稿，按 modDatetime/pubreDatetime 从新到旧排序，取前 5
const visiblePosts = allPosts.filter((p) => !p.data.draft)
const sortedPosts = [...visiblePosts]
    .sort((a, b) => {
        const aTime = (a.data.modDatetime ?? a.data.pubDatetime).valueOf()
        const bTime = (b.data.modDatetime ?? b.data.pubDatetime).valueOf()
        return bTime - aTime
    })
    .slice(0, 5)
---

<BaseLayout title="Cafe Note" description="一个简洁的个人笔记与博客网站，记录学习与思考。">
    <main class="home-page">
        <!-- 首屏 Hero -->
        <section class="hero" data-enter>
            <div class="hero-inner">
                <p class="hero-label">NOTES & BLOG</p>
                <h1 class="hero-title">Cafe Note</h1>
                <p class="hero-subtitle">
                    知识的碎片，思维的痕迹。<br />以书写整理思路，以阅读拓展边界。
                </p>
                <div class="hero-divider"></div>
                <div class="hero-stats">
                    <span>{allNotes.length} 篇笔记</span>
                    <span class="stat-sep">·</span>
                    <span>{visiblePosts.length} 篇文章</span>
                </div>
            </div>
        </section>

        <!-- 双栏区域：左笔记 / 右博客 -->
        <section class="dual-section">
            <div class="dual-inner">
                <!-- 左栏：笔记 -->
                <div class="dual-col">
                    <div class="col-header">
                        <h2 class="section-title">最新笔记</h2>
                        <a href="/notes" class="more-link">
                            查看更多
                            <span class="more-arrow" aria-hidden="true">→</span>
                        </a>
                    </div>
                    <div class="col-list">
                        {
                            sortedNotes.length === 0 ? (
                                <p class="empty-hint">暂无笔记。</p>
                            ) : (
                                sortedNotes.map((note) => (
                                    <div data-enter="">
                                        <NoteCard
                                            title={note.data.title}
                                            description={note.data.description}
                                            slug={note.slug}
                                            tags={note.data.tags}
                                        />
                                    </div>
                                ))
                            )
                        }
                    </div>
                </div>

                <!-- 右栏：博客 -->
                <div class="dual-col">
                    <div class="col-header">
                        <h2 class="section-title">最新文章</h2>
                        <a href="/posts" class="more-link">
                            查看更多
                            <span class="more-arrow" aria-hidden="true">→</span>
                        </a>
                    </div>
                    <div class="col-list">
                        {
                            sortedPosts.length === 0 ? (
                                <p class="empty-hint">暂无文章。</p>
                            ) : (
                                sortedPosts.map((post) => (
                                    <div data-enter="">
                                        <BlogCard
                                            title={post.data.title}
                                            description={post.data.description}
                                            slug={post.slug}
                                            pubDatetime={post.data.pubDatetime}
                                            tags={post.data.tags}
                                            coverImage={post.data.coverImage}
                                        />
                                    </div>
                                ))
                            )
                        }
                    </div>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .home-page {
        min-height: calc(100vh - var(--header-height));
    }

    /* ── Hero ── */
    .hero {
        background-color: var(--color-bg-secondary);
        border-bottom: 1px solid var(--color-border);
        padding: 5rem 1.5rem 4rem;
        transition: background-color var(--transition-base);
    }
    .hero-inner {
        max-width: 780px;
        margin: 0 auto;
    }
    .hero-label {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        color: var(--color-primary);
        text-transform: uppercase;
        margin: 0 0 1rem;
    }
    .hero-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 1rem;
        line-height: 1.15;
    }
    .hero-subtitle {
        font-family: var(--font-serif);
        font-size: 1.125rem;
        color: var(--color-text-muted);
        margin: 0 0 2rem;
        line-height: 1.8;
        font-style: italic;
    }
    .hero-divider {
        width: 3rem;
        height: 3px;
        background-color: var(--color-primary);
        border-radius: 2px;
        margin-bottom: 1.5rem;
    }
    .hero-stats {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        color: var(--color-text-muted);
    }
    .stat-sep {
        margin: 0 0.5rem;
        color: var(--color-border);
    }

    /* ── 双栏区域 ── */
    .dual-section {
        padding: 3rem 1.5rem;
    }
    .dual-inner {
        max-width: 780px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem;
        align-items: start;
    }

    .dual-col {
        min-width: 0;
    }

    .col-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--color-border);
    }

    .section-title {
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin: 0;
        padding: 0;
        border: none;
    }

    .more-link {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-primary);
        text-decoration: none;
        transition:
            color var(--transition-fast),
            gap var(--transition-fast);
    }

    .more-link:hover {
        color: var(--color-primary-hover);
        gap: 0.5rem;
    }

    .more-arrow {
        transition: transform var(--transition-fast);
    }

    .more-link:hover .more-arrow {
        transform: translateX(3px);
    }

    .col-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .empty-hint {
        color: var(--color-text-muted);
        font-style: italic;
        text-align: center;
        padding: 2rem 0;
        font-size: 0.9375rem;
    }

    /* ── 响应式：768px 以下单栏堆叠 ── */
    @media (max-width: 768px) {
        .hero {
            padding: 3rem 1rem 2.5rem;
        }
        .dual-section {
            padding: 2rem 1rem;
        }
        .dual-inner {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>
