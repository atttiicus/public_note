---
import BaseLayout from '../layouts/BaseLayout.astro'
import NoteCard from '../components/NoteCard.astro'
import { getCollection } from 'astro:content'

const notes = await getCollection('notes')
// 主列表按标题排序（决定各系列组/独立笔记的显示顺序）
const sorted = notes.sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'))

// ── 按 frontmatter 的 series 字段分组 ────────────────────────────
interface SeriesGroup {
  name: string
  items: Array<{ slug: string; title: string; description?: string; order?: number }>
  tags: string[]
}

const renderItems: Array<
  | { type: 'single'; note: (typeof sorted)[number] }
  | { type: 'series'; group: SeriesGroup }
> = []
const seriesMap: Record<string, SeriesGroup> = {}

for (const note of sorted) {
  const series = note.data.series
  if (series) {
    if (!seriesMap[series]) {
      seriesMap[series] = { name: series, items: [], tags: [] }
      renderItems.push({ type: 'series', group: seriesMap[series] })
    }
    const g = seriesMap[series]
    g.items.push({ slug: note.slug, title: note.data.title, description: note.data.description, order: note.data.order })
    for (const tag of note.data.tags ?? []) {
      if (!g.tags.includes(tag)) g.tags.push(tag)
    }
  } else {
    renderItems.push({ type: 'single', note })
  }
}

// 每个系列内部按 order 排序（未设则按标题兜底）
for (const group of Object.values(seriesMap)) {
  group.items.sort((a, b) => {
    const oa = a.order ?? Infinity
    const ob = b.order ?? Infinity
    if (oa !== ob) return oa - ob
    return a.title.localeCompare(b.title, 'zh-CN')
  })
}
---

<BaseLayout title="公开笔记" description="一个简洁的个人笔记网站，记录学习与思考。">
  <main class="home-page">
    <!-- 首屏 Hero -->
    <section class="hero animate-fade-in">
      <div class="hero-inner">
        <p class="hero-label">NOTES</p>
        <h1 class="hero-title">公开笔记</h1>
        <p class="hero-subtitle">知识的碎片，思维的痕迹。<br />以书写整理思路，以阅读拓展边界。</p>
        <div class="hero-divider"></div>
        <div class="hero-stats"><span>{notes.length} 篇笔记</span></div>
      </div>
    </section>

    <!-- 笔记列表 -->
    <section class="notes-section">
      <div class="notes-inner">
        <h2 class="section-title">所有笔记</h2>
        <div class="notes-grid">
          {renderItems.map((item, i) => (
            item.type === 'single' ? (
              <div class="animate-fade-in-up" style={`animation-delay:${i * 80}ms`}>
                <NoteCard
                  title={item.note.data.title}
                  description={item.note.data.description}
                  slug={item.note.slug}
                  tags={item.note.data.tags}
                />
              </div>
            ) : (
              <div class="series-group animate-fade-in-up" style={`animation-delay:${i * 80}ms`}>
                <div class="series-header">
                  <div class="series-header-left">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="series-icon" aria-hidden="true">
                      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                    </svg>
                    <span class="series-name">{item.group.name}</span>
                    <span class="series-badge">{item.group.items.length} 篇</span>
                  </div>
                  {item.group.tags.length > 0 && (
                    <div class="series-tags">
                      {item.group.tags.map(tag => (
                        <a href={`/tags/${encodeURIComponent(tag)}`} class="stag">{tag}</a>
                      ))}
                    </div>
                  )}
                </div>
                <ul class="series-list">
                  {item.group.items.map(({ slug, title, description }) => {
                    const prefix = item.group.name + '-'
                    const label = title.startsWith(prefix) ? title.slice(prefix.length) : title
                    return (
                    <li>
                      <a href={`/notes/${slug}`} class="series-item">
                        <div class="series-item-body">
                          <span class="series-item-title">{label}</span>
                          {description && <span class="series-item-desc">{description}</span>}
                        </div>
                        <span class="series-item-arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                    )
                  })}
                </ul>
              </div>
            )
          ))}
        </div>
        {notes.length === 0 && <p class="empty-hint">暂无笔记。</p>}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home-page { min-height: calc(100vh - var(--header-height)); }

  /* ── Hero ── */
  .hero {
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    padding: 5rem 1.5rem 4rem;
    transition: background-color var(--transition-base);
  }
  .hero-inner { max-width: 680px; margin: 0 auto; }
  .hero-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 1rem;
    line-height: 1.15;
  }
  .hero-subtitle {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
    line-height: 1.8;
    font-style: italic;
  }
  .hero-divider {
    width: 3rem;
    height: 3px;
    background-color: var(--color-primary);
    border-radius: 2px;
    margin-bottom: 1.5rem;
  }
  .hero-stats { font-family: var(--font-sans); font-size: 0.9375rem; color: var(--color-text-muted); }

  /* ── Notes section ── */
  .notes-section { padding: 3rem 1.5rem; }
  .notes-inner { max-width: 780px; margin: 0 auto; }
  .section-title {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .notes-grid { display: flex; flex-direction: column; gap: 1rem; }
  .empty-hint { color: var(--color-text-muted); font-style: italic; text-align: center; padding: 3rem 0; }

  /* ── 系列组 ── */
  .series-group {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background-color: var(--color-bg-card);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .series-group:hover {
    border-color: var(--color-primary-light);
    box-shadow: 0 4px 16px rgba(107, 79, 58, 0.09);
  }

  .series-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }
  .series-header-left { display: flex; align-items: center; gap: 0.5rem; }
  .series-icon { color: var(--color-primary); flex-shrink: 0; }
  .series-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .series-badge {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-primary);
    background-color: var(--color-hover);
    border: 1px solid var(--color-primary-light);
    border-radius: 100px;
    padding: 0.1em 0.6em;
  }
  .series-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .stag {
    font-size: 0.75rem;
    font-family: var(--font-sans);
    padding: 0.2em 0.6em;
    background-color: var(--color-bg-secondary);
    color: var(--color-text-muted);
    border-radius: 6px;
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }
  .stag:hover { background-color: var(--color-hover); border-color: var(--color-primary-light); color: var(--color-primary); }

  .series-list { list-style: none; margin: 0; padding: 0; }
  .series-list li { border-bottom: 1px solid var(--color-border); }
  .series-list li:last-child { border-bottom: none; }

  .series-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition-fast);
  }
  .series-item:hover { background-color: var(--color-hover); }

  .series-item-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .series-item-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }
  .series-item:hover .series-item-title { color: var(--color-primary); }
  .series-item-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .series-item-arrow {
    font-size: 1rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .series-item:hover .series-item-arrow { color: var(--color-primary); transform: translateX(4px); }

  @media (max-width: 768px) {
    .hero { padding: 3rem 1rem 2.5rem; }
    .notes-section { padding: 2rem 1rem; }
    .series-item-desc { display: none; }
  }
</style>
