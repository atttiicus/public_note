---
import BaseLayout from '../layouts/BaseLayout.astro'
import { WEB_SITE_LIST } from '../data/website'
---

<BaseLayout title="网站收藏 — 公开笔记" description="收藏的优质网站与学习资源">
  <main class="websites-page">
    <div class="websites-container animate-fade-in-up">
      <header class="page-header">
        <a href="/" class="back-link">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          返回
        </a>
        <h1 class="page-title">网站收藏</h1>
        <p class="page-subtitle">共 {WEB_SITE_LIST.length} 个网站</p>
      </header>

      {
        WEB_SITE_LIST.length === 0 ? (
          <p class="empty-hint">暂无收藏。</p>
        ) : (
          <div class="site-list">
            {WEB_SITE_LIST.map((site, i) => (
              <div class="site-card animate-fade-in-up" style={`animation-delay: ${i * 80}ms`}>
                <div class="site-main">
                  {site.logo_url && (
                    <img src={site.logo_url} alt={site.site_name} class="site-logo" />
                  )}
                  <div class="site-body">
                    <div class="site-title-row">
                      <span class="site-name">{site.site_name}</span>
                      <div class="site-links">
                        {site.site_url && (
                          <a
                            href={site.site_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="site-link"
                            title="访问网站"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <circle cx="12" cy="12" r="10" />
                              <line x1="2" y1="12" x2="22" y2="12" />
                              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                            </svg>
                            网站
                          </a>
                        )}
                        {site.github_url && (
                          <a
                            href={site.github_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="site-link"
                            title="GitHub 仓库"
                          >
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                            </svg>
                            GitHub
                          </a>
                        )}
                      </div>
                    </div>
                    <p class="site-desc">{site.site_description}</p>
                    {site.tags.length > 0 && (
                      <div class="site-tags">
                        {site.tags.map((tag) => (
                          <span class="site-tag">{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
                {(site.tips || site.read_experience) && (
                  <div class="site-extra">
                    {site.read_experience && (
                      <div class="site-extra-item">
                        <span class="extra-label">阅读体验</span>
                        <span class="extra-text">{site.read_experience}</span>
                      </div>
                    )}
                    {site.tips && (
                      <div class="site-extra-item tips">
                        <span class="extra-label">提示</span>
                        <span class="extra-text">{site.tips}</span>
                      </div>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .websites-page {
    min-height: calc(100vh - var(--header-height));
    padding: 3rem 1.5rem;
  }

  .websites-container {
    max-width: 780px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color var(--transition-fast);
  }
  .back-link:hover {
    color: var(--color-primary);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    line-height: 1.25;
  }

  .page-subtitle {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .site-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .site-card {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background-color: var(--color-bg-card);
    overflow: hidden;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .site-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: 0 4px 16px rgba(107, 79, 58, 0.09);
  }
  .dark .site-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .site-main {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
  }

  .site-logo {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-secondary);
  }

  .site-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .site-title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .site-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .site-links {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .site-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.75rem;
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--color-text-muted);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.2em 0.6em;
    text-decoration: none;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }
  .site-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary-light);
    background-color: var(--color-hover);
  }

  .site-desc {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .site-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.2rem;
  }

  .site-tag {
    font-size: 0.75rem;
    font-family: var(--font-sans);
    padding: 0.2em 0.6em;
    background-color: var(--color-bg-secondary);
    color: var(--color-text-muted);
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }

  .site-extra {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
  }

  .site-extra-item {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.8125rem;
    font-family: var(--font-sans);
  }

  .extra-label {
    font-weight: 600;
    color: var(--color-text-muted);
    flex-shrink: 0;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .extra-text {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .tips .extra-label {
    color: var(--color-primary);
  }
  .tips .extra-text {
    color: var(--color-text);
  }

  .empty-hint {
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
    padding: 3rem 0;
  }

  @media (max-width: 768px) {
    .websites-page {
      padding: 2rem 1rem;
    }
    .site-logo {
      width: 40px;
      height: 40px;
    }
  }
</style>
