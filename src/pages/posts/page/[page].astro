---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import BlogCard from '../../../components/BlogCard.astro'
import Pagination from '../../../components/Pagination.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
    const allPosts = await getCollection('posts')
    const posts = allPosts
        .filter((p) => !p.data.draft)
        .sort((a, b) => {
            const aTime = (a.data.modDatetime ?? a.data.pubDatetime).valueOf()
            const bTime = (b.data.modDatetime ?? b.data.pubDatetime).valueOf()
            return bTime - aTime
        })

    const ITEMS_PER_PAGE = 10
    const totalPages = Math.ceil(posts.length / ITEMS_PER_PAGE)

    return Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((page) => {
        const start = (page - 1) * ITEMS_PER_PAGE
        const pageItems = posts.slice(start, start + ITEMS_PER_PAGE)
        return {
            params: { page: String(page) },
            props: { pageItems, totalPages, postCount: posts.length },
        }
    })
}

const { pageItems, totalPages, postCount } = Astro.props
const currentPage = Number(Astro.params.page)
---

<BaseLayout
    title={`博客文章 · 第 ${currentPage} 页`}
    description={`共 ${postCount} 篇文章，第 ${currentPage} 页`}
>
    <main class="home-page">
        <section class="posts-section">
            <div class="posts-inner">
                <h2 class="section-title">
                    博客文章 <span class="page-indicator">· 第 {currentPage} 页</span>
                </h2>
                <div class="posts-grid">
                    {pageItems.map((post) => (
                        <div data-enter="">
                            <BlogCard
                                title={post.data.title}
                                description={post.data.description}
                                slug={post.slug}
                                pubDatetime={post.data.pubDatetime}
                                tags={post.data.tags}
                                coverImage={post.data.coverImage}
                            />
                        </div>
                    ))}
                </div>
                <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/posts" />
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .home-page { min-height: calc(100vh - var(--header-height)); }
    .posts-section { padding: 3rem 1.5rem; }
    .posts-inner { max-width: 780px; margin: 0 auto; }
    .section-title {
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin: 0 0 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--color-border);
    }
    .page-indicator { font-weight: 400; letter-spacing: 0; text-transform: none; }
    .posts-grid { display: flex; flex-direction: column; gap: 1rem; }
    @media (max-width: 768px) { .posts-section { padding: 2rem 1rem; } }
</style>
