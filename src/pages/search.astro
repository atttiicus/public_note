---
import BaseLayout from '../layouts/BaseLayout.astro'
import Search from '../components/Search.tsx'
import { getCollection } from 'astro:content'

const notes = await getCollection('notes')

function stripMarkdown(raw: string): string {
    return raw
        .replace(/^---[\s\S]*?---/m, '') // frontmatter
        .replace(/```[\s\S]*?```/g, '') // code blocks
        .replace(/`[^`]+`/g, '') // inline code
        .replace(/!\[.*?\]\(.*?\)/g, '') // images
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // links → keep text
        .replace(/#{1,6}\s/g, '') // headings
        .replace(/[*_]{1,3}([^*_]+)[*_]{1,3}/g, '$1') // bold/italic
        .replace(/^\s*[-*+]\s/gm, '') // list markers
        .replace(/^\s*\d+\.\s/gm, '') // ordered list
        .replace(/<[^>]+>/g, '') // html tags
        .replace(/\n{2,}/g, ' ')
        .replace(/\s+/g, ' ')
        .trim()
}

const noteItems = notes.map((note) => ({
    slug: note.slug,
    title: note.data.title,
    description: note.data.description,
    tags: note.data.tags,
    series: note.data.series,
    content: stripMarkdown(note.body),
}))
---

<BaseLayout title="搜索 — 公开笔记" description="搜索所有笔记">
    <main class="search-page">
        <div class="search-container animate-fade-in">
            <header class="page-header">
                <a href="/" class="back-link">
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    返回
                </a>
                <h1 class="page-title">搜索</h1>
                <p class="page-subtitle">共 {notes.length} 篇笔记</p>
            </header>

            <Search notes={noteItems} client:load />
        </div>
    </main>
</BaseLayout>

<style>
    .search-page {
        min-height: calc(100vh - var(--header-height));
        padding: 3rem 1.5rem;
    }

    .search-container {
        max-width: 780px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--color-border);
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
        text-decoration: none;
        margin-bottom: 1.5rem;
        transition: color var(--transition-fast);
    }
    .back-link:hover {
        color: var(--color-primary);
    }

    .page-title {
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 0.5rem;
        line-height: 1.25;
    }

    .page-subtitle {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        color: var(--color-text-muted);
        margin: 0;
    }

    /* ── Search 组件样式（通过全局 CSS 注入，因为 React 组件无法访问 Astro scoped style） */
    :global(.search-root) {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    :global(.search-bar) {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background-color: var(--color-bg-card);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 0.625rem 1rem;
        transition:
            border-color var(--transition-fast),
            box-shadow var(--transition-fast);
    }
    :global(.search-bar:focus-within) {
        border-color: var(--color-primary-light);
        box-shadow: 0 0 0 3px rgba(107, 79, 58, 0.1);
    }

    :global(.search-icon) {
        color: var(--color-text-muted);
        flex-shrink: 0;
    }

    :global(.search-input) {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--color-text);
    }
    :global(.search-input::placeholder) {
        color: var(--color-text-muted);
    }

    :global(.search-clear) {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border: none;
        background: none;
        color: var(--color-text-muted);
        cursor: pointer;
        border-radius: 4px;
        flex-shrink: 0;
        transition:
            color var(--transition-fast),
            background-color var(--transition-fast);
    }
    :global(.search-clear:hover) {
        color: var(--color-primary);
        background-color: var(--color-hover);
    }

    :global(.search-count) {
        font-family: var(--font-sans);
        font-size: 0.875rem;
        color: var(--color-text-muted);
        margin: 0;
    }

    :global(.search-results) {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    :global(.search-result-item) {
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background-color: var(--color-bg-card);
        overflow: hidden;
        transition:
            border-color var(--transition-fast),
            box-shadow var(--transition-fast);
    }
    :global(.search-result-item:hover) {
        border-color: var(--color-primary-light);
        box-shadow: 0 2px 12px rgba(107, 79, 58, 0.08);
    }

    :global(.search-result-link) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.875rem 1.25rem;
        text-decoration: none;
        color: inherit;
        transition: background-color var(--transition-fast);
    }
    :global(.search-result-link:hover) {
        background-color: var(--color-hover);
    }

    :global(.search-result-body) {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    :global(.search-result-title) {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-text);
        transition: color var(--transition-fast);
    }
    :global(.search-result-link:hover .search-result-title) {
        color: var(--color-primary);
    }

    :global(.search-result-series) {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        color: var(--color-primary);
        background-color: var(--color-hover);
        border: 1px solid var(--color-primary-light);
        border-radius: 100px;
        padding: 0.1em 0.55em;
        align-self: flex-start;
    }

    :global(.search-result-snippet) {
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        color: var(--color-text-muted);
        line-height: 1.5;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    :global(.search-result-tags) {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        margin-top: 0.125rem;
    }

    :global(.search-result-tag) {
        font-size: 0.7rem;
        font-family: var(--font-sans);
        padding: 0.15em 0.5em;
        background-color: var(--color-bg-secondary);
        color: var(--color-text-muted);
        border-radius: 4px;
        border: 1px solid var(--color-border);
    }

    :global(.search-result-arrow) {
        font-size: 1rem;
        color: var(--color-text-muted);
        flex-shrink: 0;
        transition:
            color var(--transition-fast),
            transform var(--transition-fast);
    }
    :global(.search-result-link:hover .search-result-arrow) {
        color: var(--color-primary);
        transform: translateX(4px);
    }

    :global(mark) {
        background-color: rgba(123, 92, 68, 0.2);
        color: var(--color-primary);
        border-radius: 2px;
        padding: 0 1px;
    }
    :global(.dark mark) {
        background-color: rgba(204, 154, 114, 0.25);
        color: var(--color-primary);
    }

    :global(.search-empty) {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        padding: 3rem 0;
        color: var(--color-text-muted);
        font-family: var(--font-sans);
        font-size: 0.9375rem;
    }
    :global(.search-empty p) {
        margin: 0;
    }

    @media (max-width: 768px) {
        .search-page {
            padding: 2rem 1rem;
        }
    }
</style>
