---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

/**
 * 性能优化思路：
 * 1. 所有数据处理在 Astro SSG 构建时完成，客户端零 JS 开销
 * 2. getCollection 是构建时 API，无运行时请求
 * 3. 月份分组使用单次遍历，O(n) 复杂度
 * 4. 侧边归属在编译时由索引奇偶确定，客户端无计算
 * 5. 时间线视觉完全由 CSS flex + 伪元素实现，零 JS 布局
 * 6. 卡片使用原生 <a> 标签，无 React 水合开销
 * 7. hover 动效仅使用 transform，触发 GPU 合成层
 */

const allNotes = await getCollection('notes')

const datedNotes = allNotes
    .filter((note) => note.data.date != null)
    .sort((a, b) => a.data.date!.valueOf() - b.data.date!.valueOf())

interface MonthGroup {
    year: number
    month: number
    label: string
    iso: string
    notes: typeof datedNotes
}

// 单次遍历分组，O(n)
const monthGroups: MonthGroup[] = []
for (const note of datedNotes) {
    const d = note.data.date!
    const y = d.getFullYear()
    const m = d.getMonth() + 1
    const last = monthGroups[monthGroups.length - 1]
    if (!last || last.year !== y || last.month !== m) {
        monthGroups.push({
            year: y,
            month: m,
            label: `${y}年${m}月`,
            iso: `${y}-${String(m).padStart(2, '0')}`,
            notes: [],
        })
    }
    monthGroups[monthGroups.length - 1].notes.push(note)
}

const totalMonths = monthGroups.length
const totalDated = datedNotes.length
---

<BaseLayout title="时间线" description="按时间顺序浏览所有笔记。">
    <main class="timeline-page">
        <section class="hero" data-enter>
            <div class="hero-inner">
                <p class="hero-label">TIMELINE</p>
                <h1 class="hero-title">时间线</h1>
                <p class="hero-subtitle">按时间追溯知识的积累与成长。</p>
                <div class="hero-divider"></div>
                <div class="hero-stats">
                    <span>{totalDated} 篇笔记</span>
                    <span class="stat-sep">·</span>
                    <span>{totalMonths} 个月份</span>
                </div>
            </div>
        </section>

        {
            totalDated === 0 ? (
                <p class="empty-hint">暂无带日期的笔记，请先为笔记添加 date 字段。</p>
            ) : (
                <div class="timeline">
                    {
                        monthGroups.map((group, i) => {
                            // 编译时确定侧边：偶右奇左，按月交替
                            const side = i % 2 === 0 ? 'right' : 'left'
                            const spacer = <div class="tl-spacer"></div>
                            const marker = (
                                <div class="tl-marker">
                                    <div class="tl-dot" aria-hidden="true"></div>
                                    <time class="tl-date" datetime={group.iso}>
                                        {group.label}
                                    </time>
                                </div>
                            )
                            const cards = (
                                <div class="tl-cards">
                                    {group.notes.map((note) => (
                                        <a
                                            href={`/notes/${note.slug}`}
                                            class="tl-card"
                                        >
                                            <span class="card-title">
                                                {note.data.title}
                                            </span>
                                            {note.data.description && (
                                                <span class="card-desc">
                                                    {note.data.description}
                                                </span>
                                            )}
                                        </a>
                                    ))}
                                </div>
                            )

                            return (
                                <div class={`tl-row side-${side} `}>
                                    {side === 'right' ? (
                                        <>{spacer}{marker}{cards}</>
                                    ) : (
                                        <>{cards}{marker}{spacer}</>
                                    )}
                                </div>
                            )
                        })
                    }
                </div>
            )
        }
    </main>
</BaseLayout>

<style>
    .timeline-page {
        min-height: calc(100vh - var(--header-height));
    }

    /* ── Hero ── */
    .hero {
        background-color: var(--color-bg-secondary);
        border-bottom: 1px solid var(--color-border);
        padding: 5rem 1.5rem 4rem;
        text-align: center;
        transition: background-color var(--transition-base);
    }
    .hero-inner {
        max-width: 780px;
        margin: 0 auto;
    }
    .hero-label {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        color: var(--color-primary);
        text-transform: uppercase;
        margin: 0 0 1rem;
    }
    .hero-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 1rem;
        line-height: 1.15;
    }
    .hero-subtitle {
        font-family: var(--font-serif);
        font-size: 1.125rem;
        color: var(--color-text-muted);
        margin: 0 0 2rem;
        font-style: italic;
    }
    .hero-divider {
        width: 3rem;
        height: 3px;
        background-color: var(--color-primary);
        border-radius: 2px;
        margin: 0 auto 1.5rem;
    }
    .hero-stats {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        color: var(--color-text-muted);
    }
    .stat-sep {
        margin: 0 0.5rem;
        color: var(--color-border);
    }
    .empty-hint {
        text-align: center;
        color: var(--color-text-muted);
        font-style: italic;
        padding: 4rem 1.5rem;
    }

    /* ═══════════════════════════════════════════════════════════════
       时间线主体

       布局原理：
       - 每行是 flex 容器，结构为 [spacer 1fr] [marker auto] [cards 1fr]
       - spacer 和 cards 各占剩余空间的一半，marker 居中（恰好在 50% 处）
       - 中心线是 .timeline 的 ::before 伪元素，位于 left: 50%
       - 中心线恰好穿过 marker 列的正中央
       ═══════════════════════════════════════════════════════════════ */

    .timeline {
        position: relative;
        max-width: 960px;
        margin: 0 auto;
        padding: 3rem 1.5rem 4rem;
    }

    /* 中心垂直线：伪元素绘制，无额外 DOM 节点 */
    .timeline::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 2px;
        background: linear-gradient(
            to bottom,
            transparent,
            var(--color-primary-light) 4%,
            var(--color-primary-light) 96%,
            transparent
        );
        transform: translateX(-50%);
        pointer-events: none;
    }

    /* ── 每行：flex 三列布局 ── */
    .tl-row {
        position: relative;
        display: flex;
        align-items: flex-start;tl-date
        z-index: 10;
    }
    .tl-row + .tl-row {
        margin-top: 2rem;
    }

    /* 左右各半的弹性区域 */
    .tl-spacer,
    .tl-cards {
        flex: 1;
        min-width: 0;
    }

    /* ── 中心标记列 ──
       固定宽度，内部垂直排列 dot + 日期标签 */
    .tl-marker {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0 1.25rem;
    }

    /* ── 时间线圆点 ── */
    .tl-dot {
        width: 12px;
        height: 12px;
        background-color: var(--color-primary);
        border: 3px solid var(--color-bg);
        border-radius: 50%;
        box-shadow: 0 0 0 3px var(--color-primary-light);
        flex-shrink: 0;
        margin-top: 0.4rem;
        transition:
            background-color var(--transition-base),
            box-shadow var(--transition-base);
    }

    /* ── 月份标签 ── */
    .tl-date {
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--color-primary);
        letter-spacing: 0.05em;
        white-space: nowrap;
        margin-top: 0.5rem;
        background-color: var(--color-bg);
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        transition:
            color var(--transition-base),
            background-color var(--transition-base);
    }

    /* ── 卡片列表 ── */
    .tl-cards {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding-top: 0.15rem;
    }

    /* ── 单张卡片 ──
       hover 仅修改 transform/box-shadow，GPU 合成 */
    .tl-card {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        padding: 0.875rem 1.125rem;
        background-color: var(--color-bg-card);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        text-decoration: none;
        color: inherit;
        transition:
            border-color var(--transition-fast),
            box-shadow var(--transition-fast),
            transform var(--transition-fast);
    }
    .tl-card:hover {
        border-color: var(--color-primary-light);
        box-shadow: 0 4px 16px rgba(107, 79, 58, 0.1);
        transform: translateY(-2px);
    }
    .card-title {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--color-text);
        line-height: 1.4;
        transition: color var(--transition-fast);
    }
    .tl-card:hover .card-title {
        color: var(--color-primary);
    }
    .card-desc {
        font-family: var(--font-serif);
        font-size: 0.8125rem;
        color: var(--color-text-muted);
        line-height: 1.5;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    /* ═══════════════════════════════════════════════════════════════
       移动端 (< 768px)：时间线左移，内容统一右侧
       ═══════════════════════════════════════════════════════════════ */
    @media (max-width: 768px) {
        .hero {
            padding: 3rem 1rem 2.5rem;
        }
        .timeline {
            padding: 2rem 1rem 3rem;
        }
        .timeline::before {
            left: 1.25rem;
        }

        /* 改为两列：固定 marker + 弹性 cards，spacer 隐藏 */
        .tl-row {
            flex-direction: row !important;
        }
        .tl-row + .tl-row {
            margin-top: 1.75rem;
        }
        .tl-spacer {
            display: none;
        }

        .tl-marker {
            flex: 0 0 auto;
            padding: 0 0.5rem 0 0;
            min-width: 2.5rem;
            align-items: center;
        }
        .tl-dot {
            width: 10px;
            height: 10px;
            border-width: 2px;
            box-shadow: 0 0 0 2px var(--color-primary-light);
            margin-top: 0.35rem;
        }
        .tl-date {
            font-size: 0.6875rem;
            padding: 0;
            background: none;
            margin-top: 0.35rem;
        }

        .tl-cards {
            flex: 1;
            min-width: 0;
            padding-top: 0;
        }
        .card-desc {
            -webkit-line-clamp: 1;
        }
    }

    @media (max-width: 480px) {
        .tl-card {
            padding: 0.7rem 0.875rem;
        }
        .card-desc {
            display: none;
        }
    }
</style>
