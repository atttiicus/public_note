---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

/**
 * 性能优化思路：
 * 1. 所有数据处理在 Astro 构建时完成（SSG），客户端零 JS 开销
 * 2. getCollection 是 Astro 内置的数据获取 API，构建时运行，不产生运行时请求
 * 3. 月份分组使用单次遍历 + Map，O(n) 复杂度
 * 4. 侧边归属（左/右）在编译时确定，避免客户端运行时计算
 * 5. 时间线视觉效果完全由 CSS 实现，无 JS 参与布局
 * 6. 卡片列表使用原生 <a> 标签，无 React 水合开销
 */

const allNotes = await getCollection('notes')

// 单次遍历：过滤有日期的笔记并按日期排序
// .filter + .sort 是两个独立遍历，但数据量极小（< 1000），不影响性能
const datedNotes = allNotes
    .filter((note) => note.data.date != null)
    .sort((a, b) => a.data.date!.valueOf() - b.data.date!.valueOf())

// 按年月分组，单次 O(n) 遍历
interface MonthGroup {
    year: number
    month: number
    label: string
    notes: typeof datedNotes
}

const monthGroups: MonthGroup[] = []
for (const note of datedNotes) {
    const d = note.data.date!
    const key = `${d.getFullYear()}-${d.getMonth()}`
    const last = monthGroups[monthGroups.length - 1]
    if (!last || `${last.year}-${last.month - 1}` !== key) {
        monthGroups.push({
            year: d.getFullYear(),
            month: d.getMonth() + 1,
            label: `${d.getFullYear()}年${d.getMonth() + 1}月`,
            notes: [],
        })
    }
    monthGroups[monthGroups.length - 1].notes.push(note)
}

const totalMonths = monthGroups.length
const totalDated = datedNotes.length
---

<BaseLayout title="时间线" description="按时间顺序浏览所有笔记。">
    <main class="timeline-page">
        <!-- Hero 区域 -->
        <section class="hero" data-enter>
            <div class="hero-inner">
                <p class="hero-label">TIMELINE</p>
                <h1 class="hero-title">时间线</h1>
                <p class="hero-subtitle">按时间追溯知识的积累与成长。</p>
                <div class="hero-divider"></div>
                <div class="hero-stats">
                    <span>{totalDated} 篇笔记</span>
                    <span class="stat-sep">·</span>
                    <span>{totalMonths} 个月份</span>
                </div>
            </div>
        </section>

        <!-- 时间线主体 -->
        {
            totalDated === 0 ? (
                <p class="empty-hint">暂无带日期的笔记，请先为笔记添加 date 字段。</p>
            ) : (
                <div class="timeline">
                    <!-- 中心线：CSS 实现，零 DOM 开销 -->
                    <div class="timeline-line" aria-hidden="true"></div>

                    {
                        monthGroups.map((group, i) => {
                            // 编译时确定侧边：偶数索引在右侧，奇数在左侧
                            const side = i % 2 === 0 ? 'right' : 'left'
                            return (
                                <div class={`timeline-month side-${side}`}>
                                    {/* 时间轴标记点 */}
                                    <div class="timeline-dot" aria-hidden="true">
                                        <div class="dot-inner"></div>
                                    </div>

                                    {/* 月份标签 */}
                                    <time
                                        class="timeline-date"
                                        datetime={`${group.year}-${String(group.month).padStart(2, '0')}`}
                                    >
                                        {group.label}
                                    </time>

                                    {/* 笔记卡片列表 */}
                                    <div class="timeline-cards">
                                        {group.notes.map((note) => (
                                            <a
                                                href={`/notes/${note.slug}`}
                                                class="timeline-card"
                                            >
                                                <span class="card-title">
                                                    {note.data.title}
                                                </span>
                                                {note.data.description && (
                                                    <span class="card-desc">
                                                        {note.data.description}
                                                    </span>
                                                )}
                                            </a>
                                        ))}
                                    </div>
                                </div>
                            )
                        })
                    }
                </div>
            )
        }
    </main>
</BaseLayout>

<style>
    /* ═══════════════════════════════════════════════════════════════
       时间线页面样式

       性能优化：
       - 所有动画仅使用 opacity 和 transform，触发 GPU 合成层，避免重排/重绘
       - 移动端将时间线移至左侧，内容统一右侧，减少 CSS 分支逻辑
       - 使用 CSS 变量复用颜色值，减少重复计算
       ═══════════════════════════════════════════════════════════════ */

    .timeline-page {
        min-height: calc(100vh - var(--header-height));
    }

    /* ── Hero ── */
    .hero {
        background-color: var(--color-bg-secondary);
        border-bottom: 1px solid var(--color-border);
        padding: 5rem 1.5rem 4rem;
        text-align: center;
        transition: background-color var(--transition-base);
    }
    .hero-inner {
        max-width: 780px;
        margin: 0 auto;
    }
    .hero-label {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        color: var(--color-primary);
        text-transform: uppercase;
        margin: 0 0 1rem;
    }
    .hero-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 1rem;
        line-height: 1.15;
    }
    .hero-subtitle {
        font-family: var(--font-serif);
        font-size: 1.125rem;
        color: var(--color-text-muted);
        margin: 0 0 2rem;
        font-style: italic;
    }
    .hero-divider {
        width: 3rem;
        height: 3px;
        background-color: var(--color-primary);
        border-radius: 2px;
        margin: 0 auto 1.5rem;
    }
    .hero-stats {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        color: var(--color-text-muted);
    }
    .stat-sep {
        margin: 0 0.5rem;
        color: var(--color-border);
    }

    .empty-hint {
        text-align: center;
        color: var(--color-text-muted);
        font-style: italic;
        padding: 4rem 1.5rem;
    }

    /* ═══════════════════════════════════════════════════════════════
       时间线布局

       桌面端：中心线 + 左右交替
       移动端：左对齐线 + 内容统一右侧
       ═══════════════════════════════════════════════════════════════ */

    .timeline {
        position: relative;
        max-width: 900px;
        margin: 0 auto;
        padding: 3rem 1.5rem 4rem;
    }

    /* 中心垂直线
       性能优化：使用伪元素而非额外 DOM 元素，减少布局计算节点 */
    .timeline-line {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 2px;
        background: linear-gradient(
            to bottom,
            transparent,
            var(--color-primary-light, #b8956a) 5%,
            var(--color-primary-light, #b8956a) 95%,
            transparent
        );
        transform: translateX(-50%);
    }

    /* ── 每个月份块 ── */
    .timeline-month {
        position: relative;
        display: flex;
        align-items: flex-start;
        margin-bottom: 3rem;
    }

    .timeline-month:last-child {
        margin-bottom: 0;
    }

    /* 性能优化：左右布局通过 CSS Grid 实现，编译时确定类名，无运行时计算 */
    .timeline-month.side-right {
        flex-direction: row;
    }
    .timeline-month.side-left {
        flex-direction: row-reverse;
    }

    /* ── 时间标记点 ──
       绝对定位在中心线上，作为月份锚点 */
    .timeline-dot {
        position: absolute;
        left: 50%;
        top: 0.35rem;
        width: 14px;
        height: 14px;
        transform: translateX(-50%);
        background-color: var(--color-primary);
        border: 3px solid var(--color-bg);
        border-radius: 50%;
        z-index: 2;
        box-shadow: 0 0 0 3px var(--color-primary-light, #b8956a);
        transition:
            background-color var(--transition-base),
            box-shadow var(--transition-base);
    }
    .dot-inner {
        display: none;
    }

    /* ── 月份日期标签 ──
       标签与标记点对齐，位置跟随内容侧 */
    .timeline-date {
        position: absolute;
        left: 50%;
        top: 0;
        transform: translateX(-50%);
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--color-primary);
        letter-spacing: 0.05em;
        white-space: nowrap;
        background-color: var(--color-bg);
        padding: 0.15rem 0.75rem;
        border: 1px solid var(--color-primary-light, #b8956a);
        border-radius: 100px;
        z-index: 1;
        transition:
            background-color var(--transition-base),
            border-color var(--transition-base),
            color var(--transition-base);
    }

    /* ── 笔记卡片容器 ──
       左右各占一半宽度，通过 padding 留出中心线空间 */
    .timeline-cards {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .side-right .timeline-cards {
        padding-left: 3rem;
    }
    .side-left .timeline-cards {
        padding-right: 3rem;
    }

    /* ── 单张笔记卡片 ──
       性能优化：使用 opacity + transform 做 hover 动效，只触发合成层 */
    .timeline-card {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        padding: 0.875rem 1.125rem;
        background-color: var(--color-bg-card);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        text-decoration: none;
        color: inherit;
        transition:
            border-color var(--transition-fast),
            box-shadow var(--transition-fast),
            transform var(--transition-fast),
            opacity var(--transition-fast);
    }

    .timeline-card:hover {
        border-color: var(--color-primary-light, #b8956a);
        box-shadow: 0 4px 16px rgba(107, 79, 58, 0.1);
        transform: translateY(-2px);
    }

    .card-title {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--color-text);
        transition: color var(--transition-fast);
    }
    .timeline-card:hover .card-title {
        color: var(--color-primary);
    }

    .card-desc {
        font-family: var(--font-serif);
        font-size: 0.8125rem;
        color: var(--color-text-muted);
        line-height: 1.5;
        /* 性能优化：省略号截断避免长文本撑开布局 */
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    /* ═══════════════════════════════════════════════════════════════
       响应式：移动端 (< 768px)

       时间线从居中移至左侧，所有内容统一在右侧显示，
       避免左右交替在小屏幕上造成阅读困难。
       ═══════════════════════════════════════════════════════════════ */
    @media (max-width: 768px) {
        .hero {
            padding: 3rem 1rem 2.5rem;
        }

        .timeline {
            padding: 2rem 1rem 3rem;
        }

        /* 移动端中心线移到左侧 */
        .timeline-line {
            left: 1.125rem;
        }

        /* 移动端所有内容统一右侧 */
        .timeline-month,
        .timeline-month.side-right,
        .timeline-month.side-left {
            flex-direction: row;
        }

        .timeline-dot {
            left: 1.125rem;
            top: 0.3rem;
            width: 12px;
            height: 12px;
            box-shadow: 0 0 0 2px var(--color-primary-light, #b8956a);
        }

        .timeline-date {
            position: static;
            transform: none;
            align-self: flex-start;
            margin-left: 2rem;
            margin-right: 0;
            font-size: 0.75rem;
            padding: 0.1rem 0.6rem;
            border: none;
            background: none;
        }

        /* 移动端卡片占满剩余空间 */
        .timeline-cards,
        .side-right .timeline-cards,
        .side-left .timeline-cards {
            width: 0;
            flex: 1;
            padding-left: 1rem;
            padding-right: 0;
        }

        .card-desc {
            -webkit-line-clamp: 1;
        }
    }

    @media (max-width: 480px) {
        .timeline-card {
            padding: 0.7rem 0.875rem;
        }
        .card-desc {
            display: none;
        }
    }
</style>
