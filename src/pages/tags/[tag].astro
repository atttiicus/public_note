---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NoteCard from '../../components/NoteCard.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
    const notes = await getCollection('notes')
    const tagSet = new Set<string>()
    for (const note of notes) {
        for (const tag of note.data.tags ?? []) tagSet.add(tag)
    }
    return [...tagSet].map((tag) => ({ params: { tag } }))
}

const { tag } = Astro.params
const allNotes = await getCollection('notes')
const notes = allNotes
    .filter((n) => n.data.tags?.includes(tag))
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'))
---

<BaseLayout title={`${tag} — 标签 — Cafe Note`} description={`标签「${tag}」下的所有笔记`}>
    <main class="tag-page">
        <div class="tag-container">
            <header class="page-header">
                <a href="/tags" class="back-link">
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    所有标签
                </a>
                <div class="heading-row">
                    <span class="tag-badge">{tag}</span>
                </div>
                <p class="page-subtitle">{notes.length} 篇笔记</p>
            </header>

            <div class="notes-grid">
                {
                    notes.map((note, i) => (
                        <div data-enter="">
                            <NoteCard
                                title={note.data.title}
                                description={note.data.description}
                                slug={note.slug}
                                tags={note.data.tags}
                            />
                        </div>
                    ))
                }
            </div>
            {notes.length === 0 && <p class="empty-hint">该标签下暂无笔记。</p>}
        </div>
    </main>
</BaseLayout>

<style>
    .tag-page {
        min-height: calc(100vh - var(--header-height));
        padding: 3rem 1.5rem;
    }

    .tag-container {
        max-width: 780px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--color-border);
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
        text-decoration: none;
        margin-bottom: 1.25rem;
        transition: color var(--transition-fast);
    }
    .back-link:hover {
        color: var(--color-primary);
    }

    .heading-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .tag-badge {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 4vw, 2.25rem);
        font-weight: 700;
        color: var(--color-text);
        line-height: 1.25;
    }
    .tag-badge::before {
        content: '#';
        color: var(--color-primary);
        margin-right: 0.2em;
        font-weight: 400;
    }

    .page-subtitle {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        color: var(--color-text-muted);
        margin: 0;
    }

    .notes-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .empty-hint {
        color: var(--color-text-muted);
        font-style: italic;
        text-align: center;
        padding: 3rem 0;
    }

    @media (max-width: 768px) {
        .tag-page {
            padding: 2rem 1rem;
        }
    }
</style>
