---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHeader from '../../components/PageHeader.astro'
import NoteCard from '../../components/NoteCard.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
    const notes = await getCollection('notes')
    const tagSet = new Set<string>()
    for (const note of notes) {
        for (const tag of note.data.tags ?? []) tagSet.add(tag)
    }
    return [...tagSet].map((tag) => ({ params: { tag } }))
}

const { tag } = Astro.params
const allNotes = await getCollection('notes')
const notes = allNotes
    .filter((n) => n.data.tags?.includes(tag))
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'))
---

<BaseLayout title={`${tag} — 标签 — Cafe Note`} description={`标签「${tag}」下的所有笔记`}>
    <main class="tag-page">
        <div class="tag-container">
            <PageHeader
                title={tag}
                titlePrefix="#"
                subtitle={`${notes.length} 篇笔记`}
                backHref="/tags"
                backText="所有标签"
            />

            <div class="notes-grid">
                {
                    notes.map((note, i) => (
                        <div data-enter="">
                            <NoteCard
                                title={note.data.title}
                                description={note.data.description}
                                slug={note.slug}
                                tags={note.data.tags}
                            />
                        </div>
                    ))
                }
            </div>
            {notes.length === 0 && <p class="empty-hint">该标签下暂无笔记。</p>}
        </div>
    </main>
</BaseLayout>

<style>
    .tag-page {
        min-height: calc(100vh - var(--header-height) - 10rem);
        padding: 3rem 1.5rem;
    }

    .tag-container {
        max-width: 780px;
        margin: 0 auto;
    }

    .notes-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .empty-hint {
        color: var(--color-text-muted);
        font-style: italic;
        text-align: center;
        padding: 3rem 0;
    }

    @media (max-width: 768px) {
        .tag-page {
            padding: 2rem 1rem;
        }
    }
</style>
