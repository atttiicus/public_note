---
import Header from '../components/Header.astro'
/**
 * 字体加载策略：
 * - Noto Sans SC（变量字体）：中文正文/标题，仅加载 Regular 400 字重以减少请求体积
 * - JetBrains Mono（变量字体）：英文正文 + 代码块，利用 CSS font-family 回退
 *   机制：'JetBrains Mono', 'Noto Sans SC', monospace
 *   → 拉丁字符命中 JetBrains Mono，CJK 字符回退到 Noto Sans SC
 */
import '@fontsource-variable/noto-sans-sc/wght.css'
import '@fontsource-variable/jetbrains-mono/wght.css'
import '../styles/styles.css'
import 'katex/dist/katex.min.css'

export interface Props {
    title: string
    description?: string
}

const { title, description = '一个简洁的个人笔记网站' } = Astro.props
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="referrer" content="no-referrer" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        {canonicalURL && <link rel="canonical" href={canonicalURL} />}
        <title>{title}</title>

        <!-- 防止主题闪烁：在渲染前设置 dark class -->
        <script is:inline>
            ;(function () {
                var saved = localStorage.getItem('theme')
                var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
                if (saved === 'dark' || ((saved === 'system' || !saved) && prefersDark)) {
                    document.documentElement.classList.add('dark')
                }
            })()
        </script>
    </head>
    <body>
        <Header currentPath={Astro.url.pathname} />
        <slot />
        <footer class="site-footer">
            <div class="footer-inner">
                <p>以书为友，以思为行。</p>
            </div>
        </footer>
    </body>
</html>

<style>
    .site-footer {
        border-top: 1px solid var(--color-border);
        margin-top: 4rem;
        padding: 2rem 1.5rem;
        text-align: center;
    }

    .footer-inner p {
        font-family: var(--font-serif);
        font-size: 0.9375rem;
        color: var(--color-text-muted);
        font-style: italic;
        margin: 0;
    }
</style>

<script>
    import gsap from 'gsap'

    const els = document.querySelectorAll('[data-enter]')
    if (els.length) {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            gsap.set(els, { opacity: 1 })
        } else {
            gsap.fromTo(
                els,
                { opacity: 0 },
                { opacity: 1, duration: 0.4, ease: 'power2.out', overwrite: true }
            )
        }
    }
</script>
