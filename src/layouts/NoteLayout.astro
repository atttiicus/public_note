---
import BaseLayout from './BaseLayout.astro'
import TableOfContents from '../components/TableOfContents.tsx'
import NoteCard from '../components/NoteCard.astro'

type RelatedNote = {
    slug: string
    title: string
    description?: string
    tags?: string[]
    order?: number
}

export interface Props {
    title: string
    description?: string
    tags?: string[]
    relatedNotes?: RelatedNote[]
    relatedType?: 'series' | 'tags' | null
    currentSlug?: string
    seriesName?: string
}

const {
    title,
    description,
    tags = [],
    relatedNotes = [],
    relatedType = null,
    currentSlug,
    seriesName,
} = Astro.props
---

<BaseLayout title={`${title} — 笔记`} description={description}>
    <main class="note-page">
        <div class="note-container" data-enter>
            <!-- 笔记头部 -->
            <header class="note-header">
                <a href="/" class="back-link">
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    返回
                </a>
                <h1 class="note-title">{title}</h1>
                {description && <p class="note-description">{description}</p>}
                {
                    tags.length > 0 && (
                        <div class="note-tags">
                            {tags.map((tag) => (
                                <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">
                                    {tag}
                                </a>
                            ))}
                        </div>
                    )
                }
            </header>

            <!-- 正文 + 目录双栏 -->
            <div class="note-layout">
                <article class="note-content prose">
                    <slot />
                </article>
                <aside class="note-toc-aside">
                    <TableOfContents client:load />
                </aside>
            </div>

            <!-- 相关文章 -->
            {
                relatedType && relatedNotes.length > 0 && (
                    <section class="related-section">
                        <div class="related-header">
                            <svg
                                width="15"
                                height="15"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                {relatedType === 'series' ? (
                                    <>
                                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                                    </>
                                ) : (
                                    <>
                                        <circle cx="18" cy="5" r="3" />
                                        <circle cx="6" cy="12" r="3" />
                                        <circle cx="18" cy="19" r="3" />
                                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                                    </>
                                )}
                            </svg>
                            <span class="related-label">
                                {relatedType === 'series' ? '系列文章' : '相关文章'}
                            </span>
                            {seriesName && (
                                <span class="related-series-name">{seriesName}</span>
                            )}
                            <span class="related-count">
                                {relatedType === 'series'
                                    ? `${relatedNotes.length} 篇`
                                    : `${relatedNotes.length} 篇`}
                            </span>
                        </div>

                        {relatedType === 'series' && (
                            <ul class="related-series-list">
                                {relatedNotes.map((n, i) => {
                                    const isCurrent = n.slug === currentSlug
                                    const prefix = seriesName ? seriesName + '-' : ''
                                    const label =
                                        prefix && n.title.startsWith(prefix)
                                            ? n.title.slice(prefix.length)
                                            : n.title
                                    return (
                                        <li>
                                            {isCurrent ? (
                                                <div class="related-series-item current">
                                                    <span class="related-order">{i + 1}</span>
                                                    <div class="related-item-body">
                                                        <span class="related-item-title">
                                                            {label}
                                                        </span>
                                                        {n.description && (
                                                            <span class="related-item-desc">
                                                                {n.description}
                                                            </span>
                                                        )}
                                                    </div>
                                                    <span class="current-badge">当前</span>
                                                </div>
                                            ) : (
                                                <a
                                                    href={`/notes/${n.slug}`}
                                                    class="related-series-item"
                                                >
                                                    <span class="related-order">{i + 1}</span>
                                                    <div class="related-item-body">
                                                        <span class="related-item-title">
                                                            {label}
                                                        </span>
                                                        {n.description && (
                                                            <span class="related-item-desc">
                                                                {n.description}
                                                            </span>
                                                        )}
                                                    </div>
                                                    <span class="related-arrow" aria-hidden="true">
                                                        →
                                                    </span>
                                                </a>
                                            )}
                                        </li>
                                    )
                                })}
                            </ul>
                        )}

                        {relatedType === 'tags' && (
                            <div class="related-tags-grid">
                                {relatedNotes.map((n) => (
                                    <NoteCard
                                        title={n.title}
                                        description={n.description}
                                        slug={n.slug}
                                        tags={n.tags}
                                    />
                                ))}
                            </div>
                        )}
                    </section>
                )
            }
        </div>
    </main>
</BaseLayout>

<!-- 代码块：语言标签 + 复制按钮 -->
<script>
    async function setupMermaid() {
        const blocks = document.querySelectorAll<HTMLElement>(
            'pre.astro-code[data-language="mermaid"]'
        )
        if (blocks.length === 0) return

        const mermaid = (await import('mermaid')).default
        const isDark = document.documentElement.classList.contains('dark')
        mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default' })

        blocks.forEach((pre) => {
            const code = pre.querySelector('code')?.textContent ?? ''
            const div = document.createElement('div')
            div.className = 'mermaid-diagram'
            div.textContent = code
            pre.replaceWith(div)
        })

        await mermaid.run({ nodes: document.querySelectorAll<HTMLElement>('.mermaid-diagram') })
    }

    function setupCodeBlocks() {
        document.querySelectorAll<HTMLElement>('pre.astro-code').forEach((pre) => {
            if (pre.dataset.enhanced) return
            if (pre.dataset.language === 'mermaid') return
            pre.dataset.enhanced = '1'

            const lang = pre.dataset.language || 'text'
            const wrapper = document.createElement('div')
            wrapper.className = 'code-wrapper'

            const header = document.createElement('div')
            header.className = 'code-header'

            const langBadge = document.createElement('span')
            langBadge.className = 'code-lang'
            langBadge.textContent = lang

            const copyBtn = document.createElement('button')
            copyBtn.className = 'code-copy-btn'
            copyBtn.setAttribute('aria-label', '复制代码')
            copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>复制</span>`

            copyBtn.addEventListener('click', async () => {
                const code = pre.querySelector('code')?.textContent ?? ''
                try {
                    await navigator.clipboard.writeText(code)
                    copyBtn.querySelector('span')!.textContent = '已复制'
                    copyBtn.classList.add('copied')
                    setTimeout(() => {
                        copyBtn.querySelector('span')!.textContent = '复制'
                        copyBtn.classList.remove('copied')
                    }, 2000)
                } catch {
                    /* silent */
                }
            })

            header.appendChild(langBadge)
            header.appendChild(copyBtn)

            pre.parentNode!.insertBefore(wrapper, pre)
            wrapper.appendChild(header)
            wrapper.appendChild(pre)
        })
    }

    // 初始化 + 路由切换后重新初始化（Astro View Transitions）
    setupCodeBlocks()
    setupMermaid()
    document.addEventListener('astro:after-swap', () => {
        setupCodeBlocks()
        setupMermaid()
    })
</script>

<style>
    /* ── 页面布局 ── */
    .note-page {
        min-height: calc(100vh - var(--header-height) - 10rem);
        padding: 3rem 1.5rem;
    }

    .note-container {
        max-width: 1160px;
        margin: 0 auto;
    }

    .note-header {
        max-width: var(--content-max-width);
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--color-border);
    }

    .note-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 3rem;
        /* 不设 align-items: start，让 aside 伸展至整行高度，sticky 才能生效 */
    }

    .note-content {
        /* 内容列自身对齐到顶部 */
        align-self: start;
    }

    @media (min-width: 1100px) {
        .note-layout {
            grid-template-columns: minmax(0, 1fr) 220px;
        }
    }

    /* ── 头部元素 ── */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
        text-decoration: none;
        margin-bottom: 1.5rem;
        transition: color var(--transition-fast);
    }

    .back-link:hover {
        color: var(--color-primary);
    }

    .note-title {
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 0.75rem;
        line-height: 1.25;
    }

    .note-description {
        font-family: var(--font-serif);
        font-size: 1.0625rem;
        color: var(--color-text-muted);
        margin: 0 0 1rem;
        font-style: italic;
        line-height: 1.7;
    }

    .note-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }

    .tag {
        font-size: 0.8125rem;
        font-family: var(--font-sans);
        padding: 0.25em 0.7em;
        background-color: var(--color-bg-secondary);
        color: var(--color-text-muted);
        border-radius: 6px;
        border: 1px solid var(--color-border);
        text-decoration: none;
        transition:
            background-color var(--transition-fast),
            border-color var(--transition-fast),
            color var(--transition-fast);
    }

    .tag:hover {
        background-color: var(--color-hover);
        border-color: var(--color-primary-light);
        color: var(--color-primary);
    }

    .note-content {
    }

    /* ── TOC 侧边栏 ── */
    .note-toc-aside {
        display: none;
    }

    @media (min-width: 1100px) {
        .note-toc-aside {
            display: block;
            position: sticky;
            top: calc(var(--header-height) + 2rem);
            align-self: start;
            max-height: calc(100vh - var(--header-height) - 4rem);
            overflow-y: auto;
        }
    }

    /* ── 代码块包装器 ── */
    :global(.code-wrapper) {
        margin: 1.5rem 0;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        overflow: hidden;
    }

    :global(.code-wrapper pre.astro-code) {
        margin: 0;
        border-radius: 0;
        border: none;
    }

    :global(.code-header) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.45rem 1rem;
        background-color: var(--color-bg-secondary);
        border-bottom: 1px solid var(--color-border);
    }

    :global(.code-lang) {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--color-primary);
        text-transform: lowercase;
        letter-spacing: 0.03em;
    }

    :global(.code-copy-btn) {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        color: var(--color-text-muted);
        background: none;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        padding: 0.2rem 0.55rem;
        cursor: pointer;
        transition:
            color var(--transition-fast),
            border-color var(--transition-fast),
            background-color var(--transition-fast);
    }

    :global(.code-copy-btn:hover) {
        color: var(--color-primary);
        border-color: var(--color-primary-light);
        background-color: var(--color-hover);
    }

    :global(.code-copy-btn.copied) {
        color: #3d9970;
        border-color: #3d9970;
    }

    :global(.mermaid-diagram) {
        margin: 1.5rem 0;
        overflow-x: auto;
        text-align: center;
    }

    :global(.mermaid-diagram svg) {
        max-width: 100%;
        height: auto;
    }

    @media (max-width: 768px) {
        .note-page {
            padding: 2rem 1rem;
        }
    }

    /* ── 相关文章模块 ── */
    .related-section {
        margin-top: 4rem;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        border-top: 3px solid var(--color-primary);
        background-color: var(--color-bg-secondary);
        overflow: hidden;
        box-shadow: 0 2px 16px rgba(107, 79, 58, 0.07);
    }

    .dark .related-section {
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.25);
    }

    .related-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.9rem 1.5rem;
        background-color: var(--color-bg);
        border-bottom: 1px solid var(--color-border);
        color: var(--color-primary);
    }

    .related-label {
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-primary);
    }

    .related-series-name {
        font-family: var(--font-serif);
        font-size: 0.9375rem;
        color: var(--color-text-muted);
        margin-left: 0.25rem;
    }

    .related-count {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--color-primary);
        background-color: var(--color-hover);
        border: 1px solid var(--color-primary-light);
        border-radius: 100px;
        padding: 0.1em 0.6em;
        margin-left: auto;
    }

    /* 系列文章列表 */
    .related-series-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .related-series-list li {
        border-bottom: 1px solid var(--color-border);
    }

    .related-series-list li:last-child {
        border-bottom: none;
    }

    .related-series-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.8rem 1.5rem;
        text-decoration: none;
        color: inherit;
        transition: background-color var(--transition-fast);
    }

    a.related-series-item:hover {
        background-color: var(--color-hover);
    }

    .related-series-item.current {
        background-color: var(--color-hover);
        border-left: 3px solid var(--color-primary);
        padding-left: calc(1.5rem - 3px);
        cursor: default;
    }

    .related-order {
        flex-shrink: 0;
        width: 1.5rem;
        height: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-text-muted);
        background-color: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: 50%;
    }

    .related-series-item.current .related-order {
        color: var(--color-primary);
        background-color: var(--color-hover);
        border-color: var(--color-primary-light);
    }

    .related-item-body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .related-item-title {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--color-text);
        transition: color var(--transition-fast);
    }

    a.related-series-item:hover .related-item-title {
        color: var(--color-primary);
    }

    .related-series-item.current .related-item-title {
        color: var(--color-primary);
        font-weight: 600;
    }

    .related-item-desc {
        font-size: 0.8125rem;
        color: var(--color-text-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .current-badge {
        flex-shrink: 0;
        font-family: var(--font-sans);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        color: var(--color-primary);
        background-color: var(--color-hover);
        border: 1px solid var(--color-primary-light);
        border-radius: 100px;
        padding: 0.15em 0.65em;
    }

    .related-arrow {
        font-size: 1rem;
        color: var(--color-text-muted);
        flex-shrink: 0;
        transition:
            color var(--transition-fast),
            transform var(--transition-fast);
    }

    a.related-series-item:hover .related-arrow {
        color: var(--color-primary);
        transform: translateX(4px);
    }

    /* 标签相关文章网格 */
    .related-tags-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        padding: 1.25rem 1.5rem;
    }

    @media (max-width: 700px) {
        .related-tags-grid {
            grid-template-columns: 1fr;
        }

        .related-item-desc {
            display: none;
        }
    }
</style>
