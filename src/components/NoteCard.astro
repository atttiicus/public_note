---
export interface Props {
  title: string
  description?: string
  slug: string
  tags?: string[]
}

const { title, description, slug, tags = [] } = Astro.props
---

<article class="note-card animate-fade-in-up">
  <!-- 主链接：标题 + 描述 + 箭头 -->
  <a href={`/notes/${slug}`} class="card-link">
    <div class="card-content">
      <h2 class="card-title">{title}</h2>
      {description && <p class="card-desc">{description}</p>}
    </div>
    <span class="card-arrow" aria-hidden="true">&#8594;</span>
  </a>

  <!-- 标签：移到主链接外，避免嵌套 <a> -->
  {
    tags.length > 0 && (
      <div class="card-tags">
        {tags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">
            {tag}
          </a>
        ))}
      </div>
    )
  }
</article>

<style>
  .note-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background-color: var(--color-bg-card);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .note-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: 0 4px 16px rgba(107, 79, 58, 0.1);
    transform: translateY(-2px);
  }

  .dark .note-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .card-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
    gap: 1rem;
  }

  .card-content {
    flex: 1;
    min-width: 0;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.4rem;
    line-height: 1.4;
    transition: color var(--transition-fast);
  }

  .note-card:hover .card-title {
    color: var(--color-primary);
  }

  .card-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-arrow {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .note-card:hover .card-arrow {
    color: var(--color-primary);
    transform: translateX(4px);
  }

  /* 标签行：细分隔线 + 与卡片圆角一致 */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0.625rem 1.5rem 1rem;
    border-top: 1px solid var(--color-border);
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-sans);
    padding: 0.2em 0.6em;
    background-color: var(--color-bg-secondary);
    color: var(--color-text-muted);
    border-radius: 6px;
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .tag:hover {
    background-color: var(--color-hover);
    border-color: var(--color-primary-light);
    color: var(--color-primary);
  }
</style>
