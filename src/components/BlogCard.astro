---
export interface Props {
    title: string
    description: string
    slug: string
    pubDatetime: Date
    tags?: string[]
    coverImage?: string
}

const { title, description, slug, pubDatetime, tags = [], coverImage } = Astro.props

/**
 * 性能优化思路：
 * 1. 日期格式化在构建时完成，无客户端开销
 * 2. 封面图片仅在存在时渲染，无条件 DOM 无额外节点
 * 3. hover 效果仅使用 CSS transform/opacity，触发 GPU 合成层
 * 4. 封面图使用 mask-image 渐变仅影响 alpha 通道，不影响布局
 * 5. 卡片为纯静态 Astro 模板，无 React 水合开销
 * 6. 标签在构建时渲染为纯 <span>，非链接（卡片整体为链接）
 */
const formattedDate = pubDatetime.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
})
---

<article class="blog-card">
    <a href={`/posts/${slug}`} class="card-link">
        <!--
            封面图片：参考 blog_org 的绝对定位叠加层方案
            - 右 60% 宽度，不挤占文字空间
            - mask-image 左到右渐变，自然融入卡片
            - 低默认透明度，hover 时加深
        -->
        {
            coverImage && (
                <div class="cover-overlay" aria-hidden="true">
                    <img
                        src={coverImage}
                        alt=""
                        referrerpolicy="no-referrer"
                        class="cover-img"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
            )
        }

        <!-- 文字内容：z-index 高于封面 -->
        <div class:list={['card-content', { 'has-cover': !!coverImage }]}>
            <time class="card-date" datetime={pubDatetime.toISOString()}>
                {formattedDate}
            </time>
            <h2 class="card-title">
                <span class="title-text">{title}</span>
                <!-- hover 时展开的下划线 -->
                <span class="title-underline" aria-hidden="true"></span>
            </h2>
            <p class="card-desc">{description}</p>
            {
                tags.length > 0 && (
                    <div class="card-tags">
                        {tags.map((tag) => (
                            <span class="tag-chip"># {tag}</span>
                        ))}
                    </div>
                )
            }
        </div>
    </a>
</article>

<style>
    .blog-card {
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background-color: var(--color-bg-card);
        overflow: hidden;
        transition:
            border-color var(--transition-fast),
            box-shadow var(--transition-fast),
            transform var(--transition-fast);
    }

    .blog-card:hover {
        border-color: var(--color-primary-light);
        box-shadow: 0 4px 16px rgba(107, 79, 58, 0.1);
        transform: translateY(-2px);
    }

    .dark .blog-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    }

    .card-link {
        position: relative;
        display: block;
        padding: 1.25rem 1.5rem;
        text-decoration: none;
        color: inherit;
    }

    /* ── 封面叠加层 ── */
    .cover-overlay {
        position: absolute;
        right: 0;
        top: 0;
        z-index: 0;
        height: 100%;
        width: 60%;
        opacity: 0.4;
        transition: opacity var(--transition-base);
    }

    .blog-card:hover .cover-overlay {
        opacity: 0.6;
    }

    .cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* 左到右渐变遮罩：左侧透明，右侧实色 */
        mask-image: linear-gradient(to right, transparent 0%, black 65%);
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 65%);
    }

    /* ── 文字内容 ── */
    .card-content {
        position: relative;
        z-index: 10;
    }

    .card-content.has-cover {
        /* 有封面时限制宽度，避免文字与图片重叠 */
        max-width: 60%;
    }

    .card-date {
        display: block;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin-bottom: 0.5rem;
    }

    .card-title {
        position: relative;
        display: inline;
        font-family: var(--font-serif);
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--color-text);
        margin: 0 0 0.5rem;
        line-height: 1.4;
        transition: color var(--transition-fast);
    }

    .blog-card:hover .card-title {
        color: var(--color-primary);
    }

    /* hover 下划线：从 0 到 100% 宽度展开 */
    .title-underline {
        position: absolute;
        bottom: -2px;
        left: 0;
        height: 2px;
        width: 0;
        background-color: var(--color-text);
        transition: width var(--transition-base);
    }

    .blog-card:hover .title-underline {
        width: 100%;
    }

    .card-desc {
        margin: 0.5rem 0 0;
        font-size: 0.875rem;
        color: var(--color-text-muted);
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
        margin-top: 0.75rem;
    }

    .tag-chip {
        font-size: 0.75rem;
        font-family: var(--font-sans);
        padding: 0.2em 0.6em;
        background-color: var(--color-bg-secondary);
        color: var(--color-text-muted);
        border-radius: 4px;
        transition:
            background-color var(--transition-fast),
            color var(--transition-fast);
    }

    .blog-card:hover .tag-chip {
        background-color: var(--color-hover);
        color: var(--color-primary);
    }

    @media (max-width: 640px) {
        .card-content.has-cover {
            max-width: 55%;
        }
    }
</style>
